{
  "name": "elo-instagram",
  "private": true,
  "version": "0.1.1",
  "description": "Gerenciador local de seguidores do Instagram em portugu\u00eas, baseado em IgDiff (MIT).",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:dev": "wxt build --mode development",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "typecheck": "wxt prepare && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare-types": "wxt prepare",
    "postinstall": "wxt prepare",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "test:ui": "node scripts/test-ui.mjs"
  },
  "dependencies": {
    "idb": "8.0.3",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@eslint/js": "9.39.5",
    "@preact/preset-vite": "2.10.6",
    "@testing-library/preact": "3.2.6",
    "eslint": "9.39.5",
    "fake-indexeddb": "6.2.5",
    "happy-dom": "21.0.4",
    "playwright": "1.64.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "7.3.6",
    "vitest": "4.1.11",
    "wxt": "0.21.4"
  },
  "license": "MIT"
}
